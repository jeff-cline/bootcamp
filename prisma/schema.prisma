generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// SQLite has no native enum support. Role is a validated string —
// the TS union type + helpers live in src/lib/roles.ts. This keeps
// the schema portable to Postgres (where a real enum can be reintroduced)
// without touching app code.
model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  name               String?
  passwordHash       String
  role               String        @default("EXECUTIVE")
  isActive           Boolean       @default(true)
  mustChangePassword Boolean       @default(false)
  createdAt          DateTime      @default(now())
  lastLoginAt        DateTime?
  activity           ActivityLog[]

  @@index([role])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Video Vault (Phase 2): YouTube-embed only, no file storage. `youtubeId`
// is the parsed 11-char id (see src/lib/youtube.ts) — never store a raw
// URL here so every consumer can build the embed URL the same way. At
// most one row should have isLive=true at a time; that invariant is
// enforced in the admin API (src/app/api/admin/videos), not the schema.
model Video {
  id          String   @id @default(cuid())
  title       String
  description String?
  youtubeId   String
  isLive      Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([isLive])
}
